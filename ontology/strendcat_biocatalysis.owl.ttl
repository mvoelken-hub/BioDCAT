###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/CatalyticEfficiency
strendcat_biocatalysis:CatalyticEfficiency rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/SBO_0000302> ,
                                                           strendcat_biocatalysis:QuantitativeAttribute ;
                                           rdfs:label "CatalyticEfficiency" ;
