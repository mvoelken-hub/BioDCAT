strendcat_biocatalysis:had_input_activity rdf:type owl:ObjectProperty ;
                                          rdfs:label "had_input_activity" ;
                                          skos:definition "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
                                          skos:exactMatch prov:wasInformedBy .


