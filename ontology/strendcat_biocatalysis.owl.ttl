###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/Biocatalyst
strendcat_biocatalysis:Biocatalyst rdf:type owl:Class ;
                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_35233> ,
                                                   strendcat_biocatalysis:MaterialEntity ;
                                   rdfs:label "Biocatalyst" ;
                                   skos:definition "An enzyme or cell that catalyzes a biocatalytic reaction. Subclass of MaterialEntity. The physical form in which it is applied is described by an associated BiocatalystPreparation; its role as the catalyst of a specific BiocatalyticReaction is described by a Catalyst wrapper via used_catalyst." ;
                                   skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_35233> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/BiocatalystApplicationFormEnum
strendcat_biocatalysis:BiocatalystApplicationFormEnum rdf:type owl:Class ;
                                                      rdfs:label "BiocatalystApplicationFormEnum" ;
                                                      skos:definition "The physical form in which a biocatalyst is applied in an experiment." .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/BiocatalystPreparation
strendcat_biocatalysis:BiocatalystPreparation rdf:type owl:Class ;
                                              rdfs:subClassOf strendcat_biocatalysis:SubstanceSample ;
                                              rdfs:label "BiocatalystPreparation" ;
                                              skos:definition "The physical form in which a Biocatalyst is applied in a BiocatalyticExperiment. Derived from the Biocatalyst entity via prov:wasDerivedFrom. Subclasses encode the specific application form; the application_form slot is retained here for P-002 converter compatibility but is redundant with the subclass type." ;
                                              skos:exactMatch <https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/00009> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/BiocatalystProductionProcess
strendcat_biocatalysis:BiocatalystProductionProcess rdf:type owl:Class ;
                                                    rdfs:subClassOf strendcat_biocatalysis:MaterialProcessing ;
                                                    rdfs:label "BiocatalystProductionProcess" ;
                                                    skos:definition "A MaterialProcessing that describes how a biocatalyst was produced, including the production organism, plasmid, and purification steps. Only present when Biocatalyst.is_self_produced is true." ;
                                                    skos:exactMatch <https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/00008> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/BiocatalyticComponent
strendcat_biocatalysis:BiocatalyticComponent rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_59999> ,
                                                             strendcat_biocatalysis:ChemicalEntity ;
                                             rdfs:label "BiocatalyticComponent" ;
                                             skos:definition "A ChemicalSubstance present in the reaction mixture of a biocatalytic experiment, regardless of its functional role (substrate, cofactor, buffer, cosolvent, etc.). Role differentiation is optional per P-002." ;
                                             skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_59999> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/BiocatalyticExperiment
strendcat_biocatalysis:BiocatalyticExperiment rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000066> ,
                                                              strendcat_biocatalysis:DataGeneratingActivity ;
                                              rdfs:label "BiocatalyticExperiment" ;
                                              skos:definition "A DataGeneratingActivity representing a biocatalytic experiment carried out according to the STRENDA Biocatalysis Guidelines. The BiocatalyticReaction is the evaluated activity; all STRENDA modules (biocatalyst, components, vessel, operation mode, conditions, sampling, results) attach to or via this class." ;
                                              skos:exactMatch <http://purl.obolibrary.org/obo/OBI_0000066> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/BiocatalyticReaction
strendcat_biocatalysis:BiocatalyticReaction rdf:type owl:Class ;
                                            rdfs:subClassOf <http://semanticscience.org/resource/SIO_010345> ,
                                                            strendcat_biocatalysis:ChemicalReaction ;
                                            rdfs:label "BiocatalyticReaction" ;
                                            skos:definition "A ChemicalReaction that is catalyzed by a Biocatalyst (enzyme or whole cell). Evaluated by a BiocatalyticExperiment. Carries reaction conditions, phase system, and result attributes." ;
                                            skos:exactMatch <http://semanticscience.org/resource/SIO_010345> .


