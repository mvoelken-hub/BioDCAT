strendcat_biocatalysis:had_input_entity rdf:type owl:ObjectProperty ;
                                        rdfs:label "had_input_entity" ;
                                        skos:definition "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
                                        skos:exactMatch prov:used .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/had_output_entity
strendcat_biocatalysis:had_output_entity rdf:type owl:ObjectProperty ;
                                         rdfs:label "had_output_entity" ;
                                         skos:definition "The slot to specify the Entity that was generated as an output of an Activity." ;
                                         skos:exactMatch prov:generated .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/has_activity
strendcat_biocatalysis:has_activity rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf strendcat_biocatalysis:has_quantitative_attribute ;
