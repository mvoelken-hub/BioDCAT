###  http://purl.obolibrary.org/obo/NCIT_C52567
<http://purl.obolibrary.org/obo/NCIT_C52567> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/NCIT_C176811> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A measure of the spontaneity of a chemical reaction. It is the change in the free energy of a system during a chemical reaction at a pH of 7.0. It is equal to the change in the enthalpy of the system minus the change in the product of the temperature times the entropy of the system.  The resulting sign of Delta G determines if a reaction is spontaneous or not: DG < 0 indicates that the reaction is spontaneous; DG > 0 indicates that the reaction is not spontaneous; and DG = 0 indicates that the reaction is at equilibrium." ;
                                             <http://purl.obolibrary.org/obo/NCIT_NHC0> "C52567" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P106> "Quantitative Concept" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P108> "Standard Gibbs Free Energy Change" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P207> "C1710182" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P366> "Standard_Gibbs_Free_Energy_Change" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Delta G Prime 0" ,
                                                                                                            "Delta G Prime Zero" ,
                                                                                                            "Standard Gibbs Free Energy Change" ,
                                                                                                            "standard gibbs free energy change" ;
                                             rdfs:label "Standard Gibbs Free Energy Change" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/NCIT_C52567> ;
