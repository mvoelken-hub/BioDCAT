###  http://purl.obolibrary.org/obo/PATO_0001241
<http://purl.obolibrary.org/obo/PATO_0001241> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/PATO_0000001> ;
                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A quality which inheres in a continuant." ;
                                              <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "PATO:0001237" ,
