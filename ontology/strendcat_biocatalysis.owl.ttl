                                              <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "snap:Quality" ;
                                              <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "monadic quality of a continuant" ,
                                                                                                             "multiply inhering quality of a physical entity" ,
