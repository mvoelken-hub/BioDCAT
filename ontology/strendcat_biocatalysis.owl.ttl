                                          rdfs:subPropertyOf strendcat_biocatalysis:had_input_activity ;
                                          rdfs:label "evaluated_activity" ;
                                          skos:definition "The slot to specify the Activity about which the DataGeneratingActivity produced information." ;
                                          skos:exactMatch prov:wasInformedBy .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/evaluated_entity
strendcat_biocatalysis:evaluated_entity rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf strendcat_biocatalysis:had_input_entity ;
                                        rdfs:label "evaluated_entity" ;
                                        skos:definition "The slot to specify the Entity about which the DataGeneratingActivity produced information." ;
                                        skos:exactMatch prov:used .


