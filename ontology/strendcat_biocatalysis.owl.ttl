                                        rdfs:label "application_form" ;
                                        skos:definition "The physical form in which the biocatalyst is applied in the experiment." ;
                                        skos:exactMatch <http://purl.obolibrary.org/obo/RO_0000086> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/blade_pitch_angle
strendcat_biocatalysis:blade_pitch_angle rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf strendcat_biocatalysis:has_quantitative_attribute ;
                                         rdfs:label "blade_pitch_angle" ;
                                         skos:definition "The pitch angle of impeller blades relative to the plane of rotation, expressed in degrees." ;
                                         skos:exactMatch <http://purl.obolibrary.org/obo/RO_0000086> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/blade_size
strendcat_biocatalysis:blade_size rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf strendcat_biocatalysis:has_quantitative_attribute ;
                                  rdfs:label "blade_size" ;
                                  skos:definition "Size (diameter) of the impeller blades." ;
                                  skos:exactMatch <http://purl.obolibrary.org/obo/RO_0000086> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/carried_out_by
strendcat_biocatalysis:carried_out_by rdf:type owl:ObjectProperty ;
                                      rdfs:label "carried_out_by" ;
                                      skos:definition "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
                                      skos:exactMatch prov:wasAssociatedWith .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/composed_of
strendcat_biocatalysis:composed_of rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf strendcat_biocatalysis:has_part ;
                                   rdfs:label "composed_of" ;
                                   skos:definition "The slot to provide the chemical entities of which a ChemicalSubstance is composed of." ;
                                   skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000051> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/deflection
strendcat_biocatalysis:deflection rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf strendcat_biocatalysis:has_quantitative_attribute ;
                                  rdfs:label "deflection" ;
                                  skos:definition "Extent of deflection of the shaker from its original position." ;
                                  skos:exactMatch <http://purl.obolibrary.org/obo/RO_0000086> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/derived_from
strendcat_biocatalysis:derived_from rdf:type owl:ObjectProperty ;
                                    rdfs:label "derived_from" ;
                                    skos:definition "The slot to specify the Entity from which a Sample was derived." ;
                                    skos:exactMatch prov:wasDerivedFrom .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/distance_between_stirrers
strendcat_biocatalysis:distance_between_stirrers rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf strendcat_biocatalysis:has_quantitative_attribute ;
                                                 rdfs:label "distance_between_stirrers" ;
                                                 skos:definition "Distance between stirring rods or impellers within the vessel." ;
                                                 skos:exactMatch <http://purl.obolibrary.org/obo/RO_0000086> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/drying_method_type
strendcat_biocatalysis:drying_method_type rdf:type owl:ObjectProperty ;
                                          rdfs:label "drying_method_type" ;
                                          skos:definition "The type of drying method applied to the biocatalyst preparation." ;
                                          skos:exactMatch <http://purl.obolibrary.org/obo/OBI_0000011> .


