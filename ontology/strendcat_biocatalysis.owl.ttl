                                                                 strendcat_biocatalysis:Dataset ;
                                                 rdfs:label "ReactionMonitoringDataset" ;
                                                 skos:definition "A Dataset about a ChemicalReaction that was produced by a ReactionMonitoring activity. This is a coarse-grained convenience shape that conflates experimental documentation and analysis into a single data-generating activity. Domain-specific sub-profiles that need to distinguish reaction monitoring from subsequent data evaluation should define their own Dataset subclasses, potentially using the DCAT-AP+ DataAnalysis/AnalysisDataset chain instead of reusing this class." ;
                                                 skos:exactMatch dcat:Dataset .


