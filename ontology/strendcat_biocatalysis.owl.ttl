###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/GibbsFreeEnergyChange
strendcat_biocatalysis:GibbsFreeEnergyChange rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/NCIT_C52567> ,
                                                             strendcat_biocatalysis:QuantitativeAttribute ;
                                             rdfs:label "GibbsFreeEnergyChange" ;
                                             skos:definition "A measure of the spontaneity of a chemical reaction. It is the change in the free energy of a system during a chemical reaction at a pH of 7.0. It is equal to the change in the enthalpy of the system minus the change in the product of the temperature times the entropy of the system.  The resulting sign of Delta G determines if a reaction is spontaneous or not: DG < 0 indicates that the reaction is spontaneous; DG > 0 indicates that the reaction is not spontaneous; and DG = 0 indicates that the reaction is at equilibrium." ;
                                             skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C52567> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/HalfLife
strendcat_biocatalysis:HalfLife rdf:type owl:Class ;
                                rdfs:subClassOf <https://purl.obolibrary.org/obo/UO_0000152> ,
                                                strendcat_biocatalysis:QuantitativeAttribute ;
                                rdfs:label "HalfLife" ;
                                skos:definition "A time unit which represents the period over which the activity or concentration of a specified chemical or element falls to half its original activity or concentration." ;
                                skos:exactMatch <https://purl.obolibrary.org/obo/UO_0000152> .


###  https://w3id.org/mvoelken-hub/StrenDCAT-Biocatalysis/HillCoefficient
strendcat_biocatalysis:HillCoefficient rdf:type owl:Class ;
                                       rdfs:subClassOf <http://purl.obolibrary.org/obo/SBO_0000190> ,
                                                       strendcat_biocatalysis:QuantitativeAttribute ;
                                       rdfs:label "HillCoefficient" ;
                                       skos:definition "Empirical parameter created by Archibald Vivian Hill to describe the cooperative binding of oxygen on hemoglobine (Hill (1910). The possible effects of the aggregation of the molecules of haemoglobin on its dissociation curves. J Physiol 40: iv-vii)." ;
                                       skos:exactMatch <http://purl.obolibrary.org/obo/SBO_0000190> .


