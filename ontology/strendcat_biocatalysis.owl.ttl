strendcat_biocatalysis:AngularVelocity rdf:type owl:Class ;
                                       rdfs:subClassOf <http://purl.obolibrary.org/obo/PATO_0001413> ,
                                                       strendcat_biocatalysis:QuantitativeAttribute ;
